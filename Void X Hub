local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Cores no estilo Desync
local corPrincipal = Color3.fromRGB(220, 220, 220) 
local corBranco = Color3.fromRGB(255, 255, 255)
local corPreto = Color3.fromRGB(0, 0, 0)

-- ==========================================
-- SISTEMA DE PROTEÇÃO (Para Executores Mobile/PC)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PrivateHubLoadingScreen"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 999999 -- Garante que cubra tudo

local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Limpa telas antigas se você executar o script duas vezes
for _, gui in pairs(ScreenGui.Parent:GetChildren()) do
    if gui.Name == "PrivateHubLoadingScreen" and gui ~= ScreenGui then
        gui:Destroy()
    end
end

-- ==========================================
-- CRIAÇÃO DA INTERFACE
-- ==========================================
-- Fundo Principal
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(1, 0, 1, 0)
MainFrame.BackgroundColor3 = corBranco 
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

-- Gradiente (Preto para o Branco igual ao original, mas com novas cores)
local BackgroundGradient = Instance.new("UIGradient")
BackgroundGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 0, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
})
BackgroundGradient.Parent = MainFrame

-- Sombra do Título
local TitleShadow = Instance.new("TextLabel")
TitleShadow.Size = UDim2.new(0, 500, 0, 80)
TitleShadow.AnchorPoint = Vector2.new(0.5, 0.5)
TitleShadow.Position = UDim2.new(0.5, 4, 0.4, 4)
TitleShadow.BackgroundTransparency = 1
TitleShadow.Text = "Void X Hub"
TitleShadow.Font = Enum.Font.Arcade
TitleShadow.TextSize = 65
TitleShadow.TextColor3 = corPreto
TitleShadow.Parent = MainFrame

-- Título Principal
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(0, 500, 0, 80)
Title.AnchorPoint = Vector2.new(0.5, 0.5)
Title.Position = UDim2.new(0.5, 0, 0.4, 0)
Title.BackgroundTransparency = 1
Title.Text = "Void X Hub"
Title.Font = Enum.Font.Arcade
Title.TextSize = 65
Title.TextColor3 = corBranco
Title.Parent = MainFrame

-- Texto: LOADING 0%
local DynamicText = Instance.new("TextLabel")
DynamicText.Size = UDim2.new(0, 300, 0, 30)
DynamicText.AnchorPoint = Vector2.new(0.5, 0.5)
DynamicText.Position = UDim2.new(0.5, 0, 0.49, 0)
DynamicText.BackgroundTransparency = 1
DynamicText.Text = "LOADING 0%"
DynamicText.Font = Enum.Font.Arcade
DynamicText.TextSize = 22
DynamicText.TextColor3 = corBranco
DynamicText.Parent = MainFrame

-- Fundo da Barra (Cor Preta Desync)
local BarBackground = Instance.new("Frame")
BarBackground.Size = UDim2.new(0, 480, 0, 14)
BarBackground.AnchorPoint = Vector2.new(0.5, 0.5)
BarBackground.Position = UDim2.new(0.5, 0, 0.56, 0)
BarBackground.BackgroundColor3 = corPreto
BarBackground.BorderSizePixel = 0
BarBackground.Parent = MainFrame

local UICornerBg = Instance.new("UICorner")
UICornerBg.CornerRadius = UDim.new(1, 0)
UICornerBg.Parent = BarBackground

-- Borda da Barra (Estilo Desync)
local BarStroke = Instance.new("UIStroke")
BarStroke.Color = corPrincipal
BarStroke.Thickness = 1
BarStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
BarStroke.Parent = BarBackground

-- Preenchimento da Barra (Cor Principal Desync)
local BarFill = Instance.new("Frame")
BarFill.Size = UDim2.new(0, 0, 1, 0)
BarFill.BackgroundColor3 = corPrincipal
BarFill.BorderSizePixel = 0
BarFill.Parent = BarBackground

local UICornerFill = Instance.new("UICorner")
UICornerFill.CornerRadius = UDim.new(1, 0)
UICornerFill.Parent = BarFill

-- ==========================================
-- ANIMAÇÃO SINCRONIZADA
-- ==========================================
local loadingTime = 3 -- Tempo reduzido para 3 segundos
local carregamentoConcluido = false 

-- Configura a animação da barra
local tweenInfo = TweenInfo.new(loadingTime, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
local barTween = TweenService:Create(BarFill, tweenInfo, {Size = UDim2.new(1, 0, 1, 0)})

barTween:Play()

local startTime = tick()
local connection

-- Loop do contador de porcentagem
connection = RunService.RenderStepped:Connect(function()
    if carregamentoConcluido then
        connection:Disconnect()
        return
    end

    local elapsed = tick() - startTime
    local percentage = math.clamp(math.floor((elapsed / loadingTime) * 100), 0, 100)
    
    DynamicText.Text = "LOADING " .. percentage .. "%"
end)

-- Espera a barra de fato terminar a animação
barTween.Completed:Wait()

-- Ativa a trava de segurança para o contador não atrapalhar
carregamentoConcluido = true
if connection then connection:Disconnect() end

-- Muda o texto e não altera mais
DynamicText.Text = "WELCOME!"

-- Espera 1.5 segundos exibindo o WELCOME 
task.wait(1.5)

-- ==========================================
-- ANIMAÇÃO DE SUMIR (FADE OUT)
-- ==========================================
local fadeTime = 0.5
local fadeInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Linear)

TweenService:Create(Title, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(TitleShadow, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(DynamicText, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(BarBackground, fadeInfo, {BackgroundTransparency = 1}):Play()
TweenService:Create(BarFill, fadeInfo, {BackgroundTransparency = 1}):Play()
TweenService:Create(BarStroke, fadeInfo, {Transparency = 1}):Play()
TweenService:Create(MainFrame, fadeInfo, {BackgroundTransparency = 1}):Play()

-- Espera sumir totalmente
task.wait(fadeTime)
ScreenGui:Destroy()

-- ==================================================
-- COLOQUE O SEU SCRIPT PRINCIPAL AQUI
-- ==================================================
print("Void X Hub Aberto com Sucesso!")
