})
BarGradient.Parent = BarFill

-- ==========================================
-- ANIMAÇÃO SINCRONIZADA E CORRIGIDA
-- ==========================================
local loadingTime = 6.5 -- Tempo da animação (6.5 segundos)
local carregamentoConcluido = false -- Nossa "trava" de segurança

-- Configura a animação da barra
local tweenInfo = TweenInfo.new(loadingTime, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
local barTween = TweenService:Create(BarFill, tweenInfo, {Size = UDim2.new(1, 0, 1, 0)})

barTween:Play()

local startTime = tick()
local connection

-- Loop do contador de porcentagem
connection = RunService.RenderStepped:Connect(function()
    if carregamentoConcluido then
        connection:Disconnect() -- Trava de segurança ativada, desliga o contador!
        return
    end

    local elapsed = tick() - startTime
    local percentage = math.clamp(math.floor((elapsed / loadingTime) * 100), 0, 100)
    
    DynamicText.Text = "LOADING " .. percentage .. "%"
end)

-- Espera a barra de fato terminar a animação
barTween.Completed:Wait()

-- Ativa a trava de segurança para o contador não atrapalhar
carregamentoConcluido = true
if connection then connection:Disconnect() end

-- Muda o texto e não altera mais
DynamicText.Text = "WELCOME!"

-- Espera 1.5 segundos exibindo o WELCOME (igual ao vídeo)
task.wait(1.5)

-- ==========================================
-- ANIMAÇÃO DE SUMIR (FADE OUT)
-- ==========================================
local fadeTime = 0.5
local fadeInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Linear)

TweenService:Create(Title, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(TitleShadow, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(DynamicText, fadeInfo, {TextTransparency = 1}):Play()
TweenService:Create(BarBackground, fadeInfo, {BackgroundTransparency = 1}):Play()
TweenService:Create(BarFill, fadeInfo, {BackgroundTransparency = 1}):Play()
TweenService:Create(MainFrame, fadeInfo, {BackgroundTransparency = 1}):Play()

-- Espera sumir totalmente
task.wait(fadeTime)
ScreenGui:Destroy()

