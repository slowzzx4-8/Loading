local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- SISTEMA DE PROTEÇÃO (Para Executores Mobile/PC)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PrivateHubLoadingScreen"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Limpa telas antigas se você executar o script duas vezes
for _, gui in pairs(ScreenGui.Parent:GetChildren()) do
    if gui.Name == "PrivateHubLoadingScreen" and gui ~= ScreenGui then
        gui:Destroy()
    end
end

-- ==========================================
-- CRIAÇÃO DA INTERFACE
-- ==========================================
